# Postgres. `docker compose up -d` starts one matching this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/algor"

PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173"
LOG_LEVEL=info
# Optional admin key required in x-admin-key for ranking config mutations (mandatory in production).
# ADMIN_API_KEY="change-me"
